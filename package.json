{
  "name": "@zaes/metoc-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "@zaes/metoc (MIT) and its sample page.",
  "author": "ZAES",
  "contributors": [
    "Edwin Sanchez <edwin.sanchez@zaes.com>"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prestart": "node scripts/copy-maplibre-worker.mjs",
    "start": "vite",
    "prestart:addons": "node scripts/copy-maplibre-worker.mjs",
    "start:addons": "vite --mode addons",
    "build": "node scripts/build-lib.mjs",
    "prebuild:demo": "node scripts/copy-maplibre-worker.mjs",
    "build:demo": "vite build && node scripts/check-free-demo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:layering": "node scripts/check-layering.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:layering && npm run build",
    "drive": "node scripts/drive-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.1",
    "@zaes/symbology-editor": "^0.1.1",
    "@zaes/symbology-engine": "^0.1.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "maplibre-gl": "^6.7.0",
    "ol": "^10.10.0",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/metoc"
  ]
}
