{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "packages/metoc/src/index.ts",
    "packages/metoc/src/openlayers/index.ts",
    "packages/metoc/src/maplibre/index.ts",
    "packages/metoc/src/editor/index.ts"
  ],
  "tsconfig": "tsconfig.json",
  "out": "site/api",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme"
  ],
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "readme": "none",
  "entryFileName": "index",
  "outputFileStrategy": "members",
  "hidePageHeader": true,
  "useCodeBlocks": true,
  "skipErrorChecking": true,
  "disableSources": true,
  "docsRoot": "./site",
  "membersWithOwnFile": [
    "Class",
    "Interface",
    "Enum"
  ],
  "sidebar": {
    "autoConfiguration": true,
    "format": "vitepress",
    "pretty": false,
    "collapsed": true
  },
  "name": "API reference",
  "enumMembersFormat": "table"
}
